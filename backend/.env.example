# --- Básicas ---

GCP_PROJECT_ID=agentspace-469418

# Sem GOOGLE_APPLICATION_CREDENTIALS: autenticação com o GCP é via ADC
# (gcloud auth application-default login --impersonate-service-account=...
# — ver seção Pré-requisitos do README e docs/adr/0007-adc-e-secret-manager-para-credenciais.md).
PORT=3001

# Tabela do BigQuery Billing Export ("Standard usage cost", já habilitado na
# Billing Account "Projetos Editora Globo") usada pela página de Custos —
# obrigatória para essa tela funcionar (sem ela, GET /api/billing/summary falha).
# Formato: projeto.dataset.tabela — ver docs/adr/0006-billing-export-como-fonte-de-custos.md.
BILLING_EXPORT_TABLE=infra-bi-355620.billing_standard.gcp_billing_export_v1_01779C_55AF20_FD92F6

# --- Autenticação (SSO / Entra ID) ---

# URL base do frontend, para onde o backend redireciona após login/logout/
# erro de autenticação. Em dev é o Vite dev server; em produção é o domínio
# público do painel.
FRONTEND_BASE_URL=http://localhost:5173

# --- Segredos (Secret Manager) ---
# Os 5 segredos da aplicação (AZURE_CLIENT_SECRET, SESSION_JWT_SECRET,
# AZURE_TENANT_ID, AZURE_CLIENT_ID, AZURE_ALLOWED_GROUP_ID) já vivem no
# Secret Manager do projeto — nenhum precisa ser declarado aqui. Em dev, o
# backend busca cada um pelo próprio nome (ex: o secret "AZURE_CLIENT_SECRET"
# alimenta a env var AZURE_CLIENT_SECRET) usando a ADC ativa; a SA impersonada
# só precisa de roles/secretmanager.secretAccessor em cada um (ver "Segredos
# no Secret Manager" do README e ADR 0007). Só é preciso declarar
# AZURE_CLIENT_SECRET_ID/SESSION_JWT_SECRET_ID/AZURE_TENANT_ID_ID/
# AZURE_CLIENT_ID_ID/AZURE_ALLOWED_GROUP_ID_ID aqui se algum desses secrets
# tiver um nome diferente do nome da env var.
