server {
    listen       ${PORT};
    server_name  _;

    root   /usr/share/nginx/html;
    index  index.html;

    # SPA routing: unknown paths fall back to index.html
    location / {
        try_files $uri $uri/ /index.html;
    }

    # Reverse proxy to the backend so the browser only ever talks to this
    # origin; BACKEND_URL is injected per environment (see Dockerfile).
    location /api/ {
        proxy_pass ${BACKEND_URL};
        proxy_http_version 1.1;
        # Obrigatório para BACKEND_URL https:// (Cloud Run): sem isso o nginx
        # não envia SNI no handshake TLS de saída, e o front-end do Google
        # (que roteia por SNI entre os vários serviços Cloud Run atrás do
        # mesmo IP/certificado wildcard) não sabe pra qual serviço mandar a
        # requisição — cai na página de erro 404 genérica do Google, nunca
        # chega no backend. Sem efeito quando BACKEND_URL é http:// (Docker
        # Compose, rede interna), mas inofensivo deixar sempre ligado.
        proxy_ssl_server_name on;
        # Host precisa ser o do BACKEND (não sobrescrever = nginx usa
        # $proxy_host, derivado da própria BACKEND_URL) — o front-end do
        # Google também roteia por Host, igual ao SNI acima; se o Host que
        # chega for o do frontend (o do browser), cai no mesmo 404 genérico
        # do Google mesmo com SNI certo. O host original do browser (que o
        # backend precisa pra montar o redirect_uri — ver auth.js) vai à
        # parte, em X-Forwarded-Host.
        proxy_set_header X-Forwarded-Host $http_host;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto $scheme;
    }

    # SSO (Entra ID): /auth/login, /auth/callback, /auth/logout, /auth/me.
    # Precisa do mesmo proxy que /api/ — o cookie de sessão só funciona como
    # same-site se o browser falar sempre com esta origem única.
    location /auth/ {
        proxy_pass ${BACKEND_URL};
        proxy_http_version 1.1;
        # Ver comentários equivalentes em location /api/ acima.
        proxy_ssl_server_name on;
        proxy_set_header X-Forwarded-Host $http_host;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto $scheme;
    }
}
