server {
    listen       ${PORT};
    server_name  _;

    root   /usr/share/nginx/html;
    index  index.html;

    # SPA routing: unknown paths fall back to index.html
    location / {
        try_files $uri $uri/ /index.html;
    }

    # Reverse proxy to the backend so the browser only ever talks to this
    # origin; BACKEND_URL is injected per environment (see Dockerfile).
    location /api/ {
        proxy_pass ${BACKEND_URL};
        proxy_http_version 1.1;
        # $http_host (não $host): $host descarta a porta do Host original,
        # o que quebra o redirect_uri derivado pelo backend (ver auth.js).
        proxy_set_header Host $http_host;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto $scheme;
    }

    # SSO (Entra ID): /auth/login, /auth/callback, /auth/logout, /auth/me.
    # Precisa do mesmo proxy que /api/ — o cookie de sessão só funciona como
    # same-site se o browser falar sempre com esta origem única.
    location /auth/ {
        proxy_pass ${BACKEND_URL};
        proxy_http_version 1.1;
        proxy_set_header Host $http_host;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto $scheme;
    }
}
